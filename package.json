{
  "name": "dsh-bwrap-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "bubblewrap confinement for DeepSeek Harness: masks every home directory, presents the session workspace as /workspace, and fences the filesystem tools to it.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./sandbox": {
      "types": "./lib/sandbox.d.ts",
      "default": "./lib/sandbox.js"
    },
    "./bash": {
      "types": "./lib/bash.d.ts",
      "default": "./lib/bash.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./guard": {
      "types": "./lib/guard.d.ts",
      "default": "./lib/guard.js"
    },
    "./spill": {
      "types": "./lib/spill.d.ts",
      "default": "./lib/spill.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "inspect:skills": "node scripts/inspect-session-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:patch": "npm run build && node scripts/sync-patch-config.mjs",
    "test": "npm run build && node scripts/check-jsdoc.mjs && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-bash-local": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-spill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
